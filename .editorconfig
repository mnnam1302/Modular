root = true

#### All files ####
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,csproj,props,targets}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

########################################################################
# C# — PART 1: STYLE OPTIONS (what the style is — no severity here)
# Severity lives in PART 2 via dotnet_diagnostic.* so IDE and
# `dotnet build` agree. The `option = value:severity` form is not
# reliably honored at build time.
########################################################################
[*.cs]

# Usings & namespaces
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace
csharp_style_namespace_declarations = file_scoped

# this. / predefined types
dotnet_style_qualification_for_field = false
dotnet_style_qualification_for_property = false
dotnet_style_qualification_for_method = false
dotnet_style_qualification_for_event = false
dotnet_style_predefined_type_for_locals_parameters_members = true
dotnet_style_predefined_type_for_member_access = true

# Modifiers
dotnet_style_require_accessibility_modifiers = for_non_interface_members
dotnet_style_readonly_field = true
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,required,volatile,async
csharp_prefer_static_local_function = true

# Blocks
csharp_prefer_braces = true
csharp_prefer_simple_using_statement = true

# var — taste, not correctness
csharp_style_var_for_built_in_types = false
csharp_style_var_when_type_is_apparent = true
csharp_style_var_elsewhere = false

# Expression-bodied — only where it never flips back and forth
csharp_style_expression_bodied_properties = true
csharp_style_expression_bodied_indexers = true
csharp_style_expression_bodied_accessors = true
csharp_style_expression_bodied_lambdas = true
csharp_style_expression_bodied_methods = when_on_single_line
csharp_style_expression_bodied_local_functions = when_on_single_line
csharp_style_expression_bodied_operators = when_on_single_line
csharp_style_expression_bodied_constructors = false

# Expressions & patterns
dotnet_style_coalesce_expression = true
dotnet_style_null_propagation = true
dotnet_style_object_initializer = true
dotnet_style_collection_initializer = true
dotnet_style_prefer_collection_expression = when_types_loosely_match
dotnet_style_explicit_tuple_names = true
dotnet_style_prefer_inferred_tuple_names = true
dotnet_style_prefer_inferred_anonymous_type_member_names = true
dotnet_style_prefer_compound_assignment = true
dotnet_style_prefer_auto_properties = true
dotnet_style_prefer_is_null_check_over_reference_equality_method = true
dotnet_style_prefer_conditional_expression_over_assignment = true
dotnet_style_prefer_conditional_expression_over_return = true
dotnet_style_parentheses_in_arithmetic_binary_operators = never_if_unnecessary
dotnet_style_parentheses_in_relational_binary_operators = never_if_unnecessary
dotnet_style_parentheses_in_other_binary_operators = never_if_unnecessary
dotnet_style_parentheses_in_other_operators = never_if_unnecessary
csharp_style_pattern_matching_over_as_with_null_check = true
csharp_style_pattern_matching_over_is_with_cast_check = true
csharp_style_prefer_switch_expression = true
csharp_style_conditional_delegate_call = true
csharp_style_throw_expression = true
csharp_style_inlined_variable_declaration = true
csharp_style_deconstructed_variable_declaration = true
csharp_style_prefer_index_operator = true
csharp_style_prefer_range_operator = true
csharp_style_prefer_primary_constructors = true
csharp_prefer_simple_default_expression = true
csharp_style_unused_value_assignment_preference = discard_variable
csharp_style_unused_value_expression_statement_preference = discard_variable
dotnet_code_quality_unused_parameters = non_public

# Formatting (only non-default values)
csharp_new_line_before_open_brace = all
csharp_new_line_before_members_in_object_initializers = false
csharp_new_line_before_members_in_anonymous_types = false
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true

# Naming
dotnet_naming_rule.interfaces_begin_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_begin_with_i.style = begins_with_i
dotnet_naming_rule.interfaces_begin_with_i.severity = warning

dotnet_naming_rule.constants_pascal.symbols = constants
dotnet_naming_rule.constants_pascal.style = pascal_case
dotnet_naming_rule.constants_pascal.severity = warning

dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning

dotnet_naming_rule.types_and_members_pascal.symbols = types_and_members
dotnet_naming_rule.types_and_members_pascal.style = pascal_case
dotnet_naming_rule.types_and_members_pascal.severity = warning

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.types_and_members.applicable_kinds = class, struct, interface, enum, record, delegate, property, method, event

dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.capitalization = pascal_case
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.pascal_case.capitalization = pascal_case

########################################################################
# C# — PART 2: SEVERITY TIERS
#   error      -> always fails the build (local + CI)
#   warning    -> yellow locally, fails in CI (TreatWarningsAsErrors on CI=true)
#   suggestion -> IDE hint only, never blocks
#   none       -> off (noise, or covered by something better)
########################################################################

# ---------- TIER 1: error — correctness & security, expensive to miss ----------
dotnet_diagnostic.CA2016.severity = error   # forward CancellationToken
dotnet_diagnostic.CA2012.severity = error   # ValueTask misuse
dotnet_diagnostic.CA2017.severity = error   # log template/argument count mismatch
dotnet_diagnostic.CA2100.severity = error   # SQL built from strings
dotnet_diagnostic.CA2326.severity = error   # JSON TypeNameHandling != None (RCE)
dotnet_diagnostic.CA2327.severity = error   # insecure JsonSerializerSettings
dotnet_diagnostic.CA5350.severity = error   # weak crypto (SHA1/3DES)
dotnet_diagnostic.CA5351.severity = error   # broken crypto (MD5/DES)
# Nullable warnings are errors via <WarningsAsErrors>nullable</...> in Directory.Build.props

# ---------- TIER 2: warning — auto-fixable consistency (`dotnet format` fixes these) ----------
dotnet_diagnostic.IDE0005.severity = warning   # unused usings
dotnet_diagnostic.IDE0055.severity = warning   # formatting
dotnet_diagnostic.IDE0161.severity = warning   # file-scoped namespace
dotnet_diagnostic.IDE0065.severity = warning   # using placement
dotnet_diagnostic.IDE0011.severity = warning   # braces
dotnet_diagnostic.IDE0003.severity = warning   # remove this.
dotnet_diagnostic.IDE0049.severity = warning   # int over Int32
dotnet_diagnostic.IDE0036.severity = warning   # modifier order
dotnet_diagnostic.IDE0040.severity = warning   # explicit accessibility
dotnet_diagnostic.IDE0044.severity = warning   # readonly field
dotnet_diagnostic.IDE0041.severity = warning   # is null
dotnet_diagnostic.IDE1006.severity = warning   # naming
# Dead code — cheap to fix, hides real bugs
dotnet_diagnostic.IDE0051.severity = warning   # unused private member
dotnet_diagnostic.IDE0052.severity = warning   # unread private member
dotnet_diagnostic.IDE0060.severity = warning   # unused parameter (non-public only)
dotnet_diagnostic.CA1849.severity = warning    # sync call inside async method
dotnet_diagnostic.CA2254.severity = warning    # non-constant log template
dotnet_diagnostic.CA1310.severity = warning    # culture-sensitive string compare

# ---------- TIER 3: suggestion — taste; flips when code shape changes ----------
dotnet_diagnostic.IDE0007.severity = suggestion  # var
dotnet_diagnostic.IDE0008.severity = suggestion  # explicit type
dotnet_diagnostic.IDE0021.severity = suggestion  # expression-bodied ctor
dotnet_diagnostic.IDE0022.severity = suggestion  # expression-bodied method
dotnet_diagnostic.IDE0045.severity = suggestion  # ?: over if-assign
dotnet_diagnostic.IDE0046.severity = suggestion  # ?: over if-return
dotnet_diagnostic.IDE0290.severity = suggestion  # primary constructor
dotnet_diagnostic.IDE0300.severity = suggestion  # collection expressions
dotnet_diagnostic.IDE0301.severity = suggestion
dotnet_diagnostic.IDE0305.severity = suggestion
dotnet_diagnostic.IDE0032.severity = suggestion  # auto property
dotnet_diagnostic.IDE0058.severity = silent      # expression value never used
dotnet_diagnostic.CA1822.severity = suggestion   # mark member static
dotnet_diagnostic.CA1852.severity = suggestion   # seal internal type
dotnet_diagnostic.CA1305.severity = suggestion   # IFormatProvider
dotnet_diagnostic.CA1848.severity = suggestion   # LoggerMessage delegates (hot paths only)

# ---------- OFF: noise, or covered by something better ----------
dotnet_diagnostic.CA1062.severity = none   # arg validation -> Nullable covers it
dotnet_diagnostic.CA2007.severity = none   # ConfigureAwait -> no SyncContext in ASP.NET Core
dotnet_diagnostic.CA1515.severity = none   # make types internal
dotnet_diagnostic.CA2000.severity = none   # dispose -> false positives with DI
dotnet_diagnostic.CA1031.severity = none   # catch Exception -> global handler does this
dotnet_diagnostic.CA1303.severity = none   # localize literals
dotnet_diagnostic.CA1000.severity = none
dotnet_diagnostic.CA1014.severity = none
dotnet_diagnostic.CA1030.severity = none
dotnet_diagnostic.CA1040.severity = none
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1724.severity = none
dotnet_diagnostic.CA1812.severity = none   # internal class never instantiated (DI does it)
dotnet_diagnostic.CA1819.severity = none
dotnet_diagnostic.CA2225.severity = none
# Sonar
dotnet_diagnostic.S1135.severity = suggestion  # TODO comments must not break builds
dotnet_diagnostic.S2325.severity = none        # duplicate of CA1822
dotnet_diagnostic.S1118.severity = none        # fires on `public partial class Program`
dotnet_diagnostic.S1121.severity = none

########################################################################
# Tests — relax rules that fight xUnit conventions
########################################################################
[**/{test,tests}/**.cs]
dotnet_diagnostic.CA1707.severity = none   # Method_Should_X naming
dotnet_diagnostic.IDE1006.severity = none
dotnet_diagnostic.CA1861.severity = none   # constant arrays in [InlineData]
dotnet_diagnostic.CA1849.severity = none
dotnet_diagnostic.CA2016.severity = suggestion

########################################################################
# Generated code — never lint
########################################################################
[**/Migrations/*.cs]
generated_code = true

[*.{g.cs,designer.cs,Designer.cs}]
generated_code = true